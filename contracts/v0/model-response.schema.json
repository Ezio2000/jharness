{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jharness.invalid/spec/v0/model-response.schema.json",
  "title": "Kernel v0 Model Response",
  "type": "object",
  "required": ["output", "finish_reason", "usage", "model_id", "response_id", "provider_turn_pending", "metadata"],
  "properties": {
    "output": {
      "type": "array",
      "minItems": 1,
      "$comment": "Items preserve provider response order; runtime and provider tool call ids must be unique across the output.",
      "items": { "$ref": "messages.schema.json#/$defs/model_output_item" }
    },
    "finish_reason": { "type": ["string", "null"] },
    "usage": {
      "oneOf": [
        { "$ref": "#/$defs/model_usage" },
        { "type": "null" }
      ]
    },
    "model_id": { "type": ["string", "null"] },
    "response_id": { "type": ["string", "null"] },
    "provider_turn_pending": { "type": "boolean" },
    "metadata": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "provider_turn_pending": { "const": false } },
        "required": ["provider_turn_pending"]
      },
      "then": {
        "properties": {
          "output": {
            "not": {
              "contains": {
                "allOf": [
                  {
                    "$ref": "messages.schema.json#/$defs/provider_tool_call_output_item"
                  },
                  {
                    "properties": { "status": { "const": "in_progress" } },
                    "required": ["status"]
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "model_usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "total_tokens", "reasoning_tokens", "cache_read_tokens", "cache_write_tokens"],
      "properties": {
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "reasoning_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cache_read_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cache_write_tokens": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
