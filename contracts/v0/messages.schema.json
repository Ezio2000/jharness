{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jharness.invalid/spec/v0/messages.schema.json",
  "title": "Kernel v0 Message",
  "$ref": "#/$defs/message",
  "$defs": {
    "message": {
      "oneOf": [
        { "$ref": "#/$defs/regular_message" },
        { "$ref": "#/$defs/assistant_message" },
        { "$ref": "#/$defs/tool_message" }
      ]
    },
    "regular_message": {
      "type": "object",
      "required": ["role", "parts", "metadata"],
      "properties": {
        "role": { "enum": ["system", "user", "external"] },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/content_part" }
        },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "assistant_message": {
      "type": "object",
      "required": ["role", "output", "metadata"],
      "properties": {
        "role": { "const": "assistant" },
        "output": {
          "type": "array",
          "minItems": 1,
          "$comment": "Runtime and provider tool call ids must be unique across the ordered output. SDK semantic validation enforces uniqueness by id.",
          "items": { "$ref": "#/$defs/model_output_item" }
        },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "tool_message": {
      "type": "object",
      "required": ["role", "tool_call_id", "outcome", "metadata"],
      "properties": {
        "role": { "const": "tool" },
        "tool_call_id": { "type": "string", "minLength": 1 },
        "outcome": { "$ref": "#/$defs/tool_outcome" },
        "metadata": { "type": "object" }
      },
      "$comment": "The outcome is the single model-visible tool result. Host suspension data is never copied into a message.",
      "additionalProperties": false
    },
    "runtime_tool_call": {
      "oneOf": [
        { "$ref": "#/$defs/structured_tool_call" },
        { "$ref": "#/$defs/freeform_tool_call" }
      ]
    },
    "structured_tool_call": {
      "type": "object",
      "required": ["input_kind", "id", "name", "arguments"],
      "properties": {
        "input_kind": { "const": "structured" },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "arguments": { "type": "object" }
      },
      "additionalProperties": false
    },
    "freeform_tool_call": {
      "type": "object",
      "required": ["input_kind", "id", "name", "input"],
      "properties": {
        "input_kind": { "const": "freeform" },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "input": { "type": "string" }
      },
      "additionalProperties": false
    },
    "model_output_item": {
      "oneOf": [
        { "$ref": "#/$defs/content_output_item" },
        { "$ref": "#/$defs/runtime_tool_call_output_item" },
        { "$ref": "#/$defs/provider_tool_call_output_item" }
      ]
    },
    "content_output_item": {
      "type": "object",
      "required": ["kind", "content"],
      "properties": {
        "kind": { "const": "content" },
        "content": { "$ref": "#/$defs/content_part" }
      },
      "additionalProperties": false
    },
    "runtime_tool_call_output_item": {
      "oneOf": [
        { "$ref": "#/$defs/structured_runtime_tool_call_output_item" },
        { "$ref": "#/$defs/freeform_runtime_tool_call_output_item" }
      ]
    },
    "structured_runtime_tool_call_output_item": {
      "type": "object",
      "required": ["kind", "input_kind", "id", "name", "arguments"],
      "properties": {
        "kind": { "const": "runtime_tool_call" },
        "input_kind": { "const": "structured" },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "arguments": { "type": "object" }
      },
      "additionalProperties": false
    },
    "freeform_runtime_tool_call_output_item": {
      "type": "object",
      "required": ["kind", "input_kind", "id", "name", "input"],
      "properties": {
        "kind": { "const": "runtime_tool_call" },
        "input_kind": { "const": "freeform" },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "input": { "type": "string" }
      },
      "additionalProperties": false
    },
    "provider_tool_call_output_item": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "tool",
        "status",
        "arguments",
        "output",
        "error",
        "metadata"
      ],
      "properties": {
        "kind": { "const": "provider_tool_call" },
        "id": { "type": "string", "minLength": 1 },
        "tool": { "$ref": "#/$defs/provider_tool_id" },
        "status": {
          "enum": ["in_progress", "completed", "incomplete", "failed"]
        },
        "arguments": { "type": "object" },
        "output": {
          "type": "array",
          "items": { "$ref": "#/$defs/content_part" }
        },
        "error": {
          "oneOf": [
            { "$ref": "#/$defs/error_info" },
            { "type": "null" }
          ]
        },
        "metadata": { "type": "object" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "failed" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "error": { "$ref": "#/$defs/error_info" } }
          },
          "else": {
            "properties": { "error": { "type": "null" } }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "in_progress" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "output": { "maxItems": 0 } }
          }
        }
      ],
      "additionalProperties": false
    },
    "provider_tool_id": {
      "type": "object",
      "required": ["namespace", "type"],
      "properties": {
        "namespace": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "tool_outcome": {
      "oneOf": [
        { "$ref": "#/$defs/tool_success" },
        { "$ref": "#/$defs/tool_failure" },
        { "$ref": "#/$defs/tool_accepted" },
        { "$ref": "#/$defs/tool_waiting" }
      ]
    },
    "tool_success": {
      "type": "object",
      "required": ["kind", "parts", "structured_content"],
      "properties": {
        "kind": { "const": "success" },
        "parts": { "$ref": "#/$defs/non_empty_parts" },
        "structured_content": true
      },
      "additionalProperties": false
    },
    "tool_failure": {
      "type": "object",
      "required": ["kind", "parts", "error", "structured_content"],
      "properties": {
        "kind": { "const": "failure" },
        "parts": { "$ref": "#/$defs/non_empty_parts" },
        "error": { "$ref": "#/$defs/error_info" },
        "structured_content": true
      },
      "additionalProperties": false
    },
    "tool_accepted": {
      "type": "object",
      "required": ["kind", "parts", "correlation_id", "task", "structured_content"],
      "properties": {
        "kind": { "const": "accepted" },
        "parts": { "$ref": "#/$defs/non_empty_parts" },
        "correlation_id": { "type": "string", "minLength": 1 },
        "task": { "$ref": "#/$defs/nullable_task_ref" },
        "structured_content": true
      },
      "additionalProperties": false
    },
    "tool_waiting": {
      "type": "object",
      "required": ["kind", "parts", "task", "structured_content"],
      "properties": {
        "kind": { "const": "waiting" },
        "parts": { "$ref": "#/$defs/non_empty_parts" },
        "task": { "$ref": "#/$defs/nullable_task_ref" },
        "structured_content": true
      },
      "$comment": "Waiting is model-visible, but its host suspension is carried only by ToolResult and Suspended state.",
      "additionalProperties": false
    },
    "non_empty_parts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/content_part" }
    },
    "error_info": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "nullable_task_ref": {
      "oneOf": [
        { "$ref": "#/$defs/task_ref" },
        { "type": "null" }
      ]
    },
    "task_ref": {
      "type": "object",
      "required": ["id", "status", "metadata"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "content_part": {
      "oneOf": [
        { "$ref": "#/$defs/text_part" },
        { "$ref": "#/$defs/artifact_part" },
        { "$ref": "#/$defs/opaque_part" }
      ]
    },
    "text_part": {
      "type": "object",
      "required": ["type", "text", "metadata"],
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string" },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "artifact_part": {
      "type": "object",
      "required": ["type", "artifact", "metadata"],
      "properties": {
        "type": { "const": "artifact" },
        "artifact": { "$ref": "#/$defs/artifact" },
        "metadata": { "type": "object" }
      },
      "$comment": "artifact is the single authoritative artifact payload.",
      "additionalProperties": false
    },
    "opaque_part": {
      "type": "object",
      "required": ["type", "metadata"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "not": { "enum": ["text", "artifact"] }
        },
        "text": { "type": "string" },
        "uri": { "type": "string", "minLength": 1 },
        "media_type": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "data": { "type": "object", "minProperties": 1 },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["ref", "metadata"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "media_type": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "minLength": 1 },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
